<Window x:Class="CatShelterWPF.ExportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт данных" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <StackPanel>
            <!-- Заголовок -->
            <TextBlock Text="Экспорт котиков" 
                       FontSize="16" 
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <!-- Формат -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Формат:" Width="80" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}"
                          Width="100"/>
            </StackPanel>

            <!-- Папка -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Папка:" Width="80" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SelectedFolder}" 
                         IsReadOnly="True"
                         Width="250"
                         Background="#F5F5F5"/>
            </StackPanel>

            <!-- Кнопка выбора папки -->
            <Button Content="Выбрать место сохранения..." 
                    Command="{Binding BrowseCommand}"
                    Width="250" Margin="80,0,0,15"/>

            <!-- Имя файла -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Имя файла:" Width="80" VerticalAlignment="Center"/>
                <TextBox Text="{Binding FileName}" 
                         Width="250"/>
            </StackPanel>

            <!-- Статус -->
            <TextBlock Text="{Binding StatusMessage}" 
                       Margin="0,0,0,15"
                       TextWrapping="Wrap"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        Width="80" 
                        Margin="0,0,10,0"/>
                <Button Content="Экспортировать" 
                        Command="{Binding ExportCommand}"
                        Width="100">
                    <!-- Самый простой способ -->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="Content" Value="Идет экспорт..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>