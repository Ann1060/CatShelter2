<Window x:Class="CatShelterWPF.DeleteConfirmView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления" Height="200" Width="350"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="25" VerticalAlignment="Center">
        <TextBlock Text="Вы хотите удалить кота? 😿" 
                   TextWrapping="Wrap"
                   FontSize="14" 
                   TextAlignment="Center"
                   Margin="0,0,0,30"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Да" 
                    Command="{Binding ConfirmDeleteCommand}"
                    Background="Red" Foreground="White"
                    Margin="10" Padding="20,8"/>
            <Button Content="Нет" 
                    Command="{Binding CancelDeleteCommand}"
                    Margin="10" Padding="20,8"/>
        </StackPanel>
    </StackPanel>
</Window>