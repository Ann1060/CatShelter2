<Window x:Class="CatShelterWPF.EditCatView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать кота" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="25">
        <TextBlock Text="Редактировать кота" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,25"
                   HorizontalAlignment="Center"/>

        <!-- ПОЛЕ ИМЕНИ -->
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Имя:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditingCat.Name, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5,0,0" 
                     Padding="8" 
                     Height="30"
                     FontSize="14"/>
        </StackPanel>

        <!-- ПОЛЕ ВОЗРАСТА -->
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Возраст:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditingCat.Age, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5,0,0" 
                     Padding="8" 
                     Height="30"
                     FontSize="14"/>
        </StackPanel>

        <!-- ПОЛЕ ПОРОДЫ -->
        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="Порода:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditingCat.Breed, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5,0,0" 
                     Padding="8" 
                     Height="30"
                     FontSize="14"/>
        </StackPanel>

        <!-- КНОПКИ -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button Content="Сохранить" 
                    Command="{Binding SaveEditCommand}"
                    Background="#007ACC" 
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="10" 
                    Padding="20,8"
                    Width="100"
                    Height="35"/>

            <Button Content="Отмена" 
                    Command="{Binding CancelEditCommand}"
                    Background="LightGray"
                    FontWeight="SemiBold"
                    Margin="10" 
                    Padding="20,8"
                    Width="100"
                    Height="35"/>
        </StackPanel>
    </StackPanel>
</Window>