<Window x:Class="CatShelterWPF.AddCatView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить кота" Height="345" Width="350"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="25">
        <TextBlock Text="Добавить кота" 
                   FontSize="16" FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- ПОЛЕ ИМЕНИ -->
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Имя:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5,0,0" Padding="5" Height="25"/>
        </StackPanel>

        <!-- ПОЛЕ ВОЗРАСТА -->
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Возраст:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5,0,0" Padding="5" Height="25"/>
        </StackPanel>

        <!-- ПОЛЕ ПОРОДЫ -->
        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="Порода:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Breed, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,5,0,0" Padding="5" Height="25"/>
        </StackPanel>

        <!-- КНОПКИ -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" 
                    Command="{Binding SaveCatCommand}"
                    Background="#007ACC" Foreground="White"
                    Margin="5" Padding="15,5"/>
            <Button Content="Отмена" 
                    Command="{Binding CancelAddCommand}"
                    Margin="5" Padding="15,5"/>
        </StackPanel>
    </StackPanel>
</Window>