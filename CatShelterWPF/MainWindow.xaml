<Window x:Class="CatShelterWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Shelter" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК -->
        <TextBlock Text="Учет котов в приюте" 
                   FontSize="20" FontWeight="Bold" 
                   Margin="10" HorizontalAlignment="Center"/>

        <!-- ТАБЛИЦА С КОТАМИ -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Cats}" 
                  SelectedItem="{Binding SelectedCat}"
                  AutoGenerateColumns="False"
                  Margin="10"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="80"/>
                <DataGridTextColumn Header="Порода" Binding="{Binding Breed}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ПАНЕЛЬ КНОПОК -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <Button Content="Добавить кота" 
                    Command="{Binding OpenAddDialogCommand}"
                    Margin="5" Padding="15,5"/>
            <Button Content="Редактировать" 
                    Command="{Binding OpenEditDialogCommand}"
                    Margin="5" Padding="15,5"/>
            <Button Content="Удалить" 
                    Command="{Binding OpenDeleteDialogCommand}"
                    Margin="5" Padding="15,5"/>
            <Button Content="Статистика" 
                    Command="{Binding ShowStatisticsCommand}"
                    Margin="5" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>